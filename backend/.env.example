# LLM defaults
# Supported providers: zhipu, bailian, deepseek, openai
LLM_PROVIDER=zhipu
LLM_MODEL=glm-5
LLM_API_KEY=
LLM_BASE_URL=

# Zhipu / BigModel
ZHIPU_API_KEY=your_key
ZHIPUAI_API_KEY=your_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5

# Bailian / DashScope
BAILIAN_API_KEY=your_key
DASHSCOPE_API_KEY=your_key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.5-plus

# DeepSeek
DEEPSEEK_API_KEY=your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible embeddings defaults
# Supported providers: zhipu, bailian, openai
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# OpenAI embeddings
OPENAI_API_KEY=your_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Redis（可选，不配置则自动降级为纯文件模式）
REDIS_URL=redis://localhost:6379/0

# RAG 检索证据语义缓存（可选，命中时跳过 Multi-Query/混合检索/Rerank，仍生成答案）
# RAG_CACHE_ENABLED=true      # 开关，false 则完全走原管线
# RAG_CACHE_TTL=86400         # 缓存有效期（秒），默认 24h
# RAG_CACHE_THRESHOLD=0.92    # 语义命中余弦阈值（建议 0.90-0.95，调低会答非所问）
# RAG_CACHE_MAX_ENTRIES=500   # 内存语义索引最大条目数，超限淘汰最旧

# 知识库路由判断（判断"是否进知识库检索"）：显式关键词直通 + LLM 二分类
# 不配 API Key 时回退链：RAG_ROUTER_API_KEY → SUMMARY_API_KEY → 主模型
# RAG_ROUTER_ENABLED=true
# RAG_ROUTER_MODEL=deepseek-v4-flash
# RAG_ROUTER_API_KEY=
# RAG_ROUTER_BASE_URL=https://api.deepseek.com

# PostgreSQL（已无消费方：长期记忆迁至 ChromaDB 嵌入式 SQLite 后不再读 PG，此项可删）
# PG_DSN=postgresql://ragapp:ragapp123@localhost:5432/raglongmem

# 短期记忆自动压缩（可选）
# AUTO_COMPRESS_TOKEN_LIMIT=12000    # 会话历史（含摘要链）token 预算，超过触发压缩
# SUMMARY_CHAIN_TOKEN_LIMIT=3000     # 压缩摘要链 token 上限，超过二次折叠为单条
# SUMMARY_MODEL=deepseek-v4-flash    # 压缩/摘要用模型（缺省回退主模型）
# SUMMARY_API_KEY=your_key
# SUMMARY_BASE_URL=https://api.deepseek.com
# MAX_CONTEXT_TOKENS=128000          # LLM 上下文窗口，达 80% 硬上限强制压缩
# COMPONENT_CHAR_LIMIT=20000         # 系统提示词各组件最大字符数
# TERMINAL_TIMEOUT_SECONDS=30        # terminal 工具单次执行超时

# Tavily web search
TAVILY_API_KEY=your_key
TAVILY_PROJECT=

# Amap (高德地图) MCP — streamable http
# Key 在高德开放平台（lbs.amap.com）控制台 → 应用管理 → 创建 Web服务 key
AMAP_API_KEY=your_key

# LangSmith tracing（检索链路追踪，smith.langchain.com）
# 有 Key 才会上报；无 Key 时 app 启动会强制关闭追踪，不影响运行
LANGSMITH_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=rag-project
